{
  "name": "@ai-lca-tools/chat-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable React chat panel for host-registered AI application tools",
  "files": [
    "dist",
    "styles.css",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "happy-dom": "^20.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "~5.7.2"
  }
}
